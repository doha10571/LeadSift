      "parameters": {
        "jsonSchemaExample": "{\n  \"need\": \"AI chatbot for website\",\n  \"pain_point\": \"Answer customer questions\",\n  \"budget\": \"not provided\",\n  \"timeline\": \"3 months\",\n  \"authority\": \"influencer\",\n  \"urgency\": \"low\",\n  \"purchase_intent\": \"medium\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        528,
        352
      ],
      "id": "eff4d5ce-3779-4184-bf1b-21b178a4c2d0",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "// Get structured data from LLM\nconst data = $json.output;\n\n// Get original Tally submission\nconst tally = $('Tally Trigger').first().json;\n\n// Function to get answer by question label\nfunction getAnswer(label) {\n  const key = Object.keys(tally).find(\n    key => tally[key]?.label === label\n  );\n\n  return key ? tally[key].value : \"not provided\";\n}\n\n// Get customer information\nconst name = getAnswer(\"Name\");\nconst email = getAnswer(\"Email\");\nconst phone = getAnswer(\"Phone\");\nconst brief = getAnswer(\"Brief\");\n\n// Calculate lead score\nlet score = 0;\n\n// Need\nif (data.need && data.need !== \"not provided\") {\n  score += 25;\n}\n\n// Timeline\nif (data.timeline && data.timeline !== \"not provided\") {\n  score += 20;\n}\n\n// Budget\nif (data.budget && data.budget !== \"not provided\") {\n  score += 20;\n}\n\n// Authority\nif (data.authority === \"decision_maker\") {\n  score += 15;\n} else if (data.authority === \"influencer\") {\n  score += 8;\n}\n\n// Urgency\nif (data.urgency === \"high\") {\n  score += 10;\n} else if (data.urgency === \"medium\") {\n  score += 5;\n}\n\n// Purchase Intent\nif (data.purchase_intent === \"high\") {\n  score += 10;\n} else if (data.purchase_intent === \"medium\") {\n  score += 5;\n}\n\n// Classify lead\nlet classification;\n\nif (score >= 80) {\n  classification = \"HOT\";\n} else if (score >= 50) {\n  classification = \"WARM\";\n} else {\n  classification = \"COLD\";\n}\n\n// Final output\nreturn [\n  {\n    json: {\n      name,\n      email,\n      phone,\n      brief,\n\n      need: data.need,\n      pain_point: data.pain_point,\n      budget: data.budget,\n      timeline: data.timeline,\n      authority: data.authority,\n      urgency: data.urgency,\n      purchase_intent: data.purchase_intent,\n\n      score,\n      classification\n    }\n  }\n];"
      },
